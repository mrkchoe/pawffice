# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional for demo mode — leave blank to use localStorage demo store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Arcade.dev — Google Calendar + Gmail (shelter account)
# Get an API key from https://docs.arcade.dev
ARCADE_API_KEY=

# "mock" (default) or "arcade"
# In the UI, Arcade mode prompts for your signed-in Arcade account email.
ARCADE_CALENDAR_MODE=mock
